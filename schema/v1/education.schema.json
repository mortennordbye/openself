{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mortennordbye/openself/main/schema/v1/education.schema.json",
  "title": "Education",
  "description": "All education, one table row each: Degree | School | From | To | Source.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "description": "Schema version of this file.",
      "enum": [
        "1"
      ]
    },
    "id": {
      "type": "string",
      "description": "Stable id. Equal to the file name without .md. Never changed or reused.",
      "pattern": "^education$"
    },
    "type": {
      "type": "string",
      "description": "Entry type.",
      "enum": [
        "education"
      ]
    },
    "sources": {
      "type": "array",
      "description": "Where the facts come from, as labels (never paths): 'interview 2026-05-13', 'intake:old-cv.pdf', 'linkedin', 'self-edit 2026-10-20'.",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "description": "How sure the facts are: verified (the owner checked this entry), stated (the owner said it), old-cv, linkedin, needs-confirmation. Empty means not assessed.",
      "enum": [
        "",
        "verified",
        "stated",
        "old-cv",
        "linkedin",
        "needs-confirmation"
      ]
    },
    "status": {
      "type": "string",
      "description": "active, or removed (only in _removed/).",
      "enum": [
        "",
        "active",
        "removed"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "description": "Date the entry was last checked or changed (YYYY-MM-DD).",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$"
    },
    "removed": {
      "type": "string",
      "description": "Date the entry was removed.",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$",
      "x-scaffold": false
    },
    "removed_reason": {
      "type": "string",
      "description": "Why the entry was removed, in the owner's words.",
      "x-scaffold": false
    }
  },
  "required": [
    "schema",
    "id",
    "type"
  ],
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": {}
  },
  "additionalProperties": false,
  "x-sections": [
    "other",
    "flags"
  ],
  "x-body": {
    "table": [
      "degree",
      "school",
      "from",
      "to",
      "source"
    ]
  }
}
