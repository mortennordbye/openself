{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mortennordbye/openself/main/schema/v1/employment.schema.json",
  "title": "Employment",
  "description": "One employment: one real title at one employer. A new title is a new employment.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "description": "Schema version of this file.",
      "enum": [
        "1"
      ]
    },
    "id": {
      "type": "string",
      "description": "Stable id. Equal to the file name without .md. Never changed or reused.",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "type": {
      "type": "string",
      "description": "Entry type.",
      "enum": [
        "employment"
      ]
    },
    "employer": {
      "type": "string",
      "description": "The employer's name."
    },
    "title": {
      "type": "string",
      "description": "The real title, exactly as the employer uses it."
    },
    "title_en": {
      "type": "string",
      "description": "Vetted English version of the title, when the profile is not in English.",
      "x-scaffold": false
    },
    "location": {
      "type": "string",
      "description": "City or place."
    },
    "start": {
      "type": "string",
      "description": "First month, YYYY-MM (YYYY when the month is not known).",
      "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?)$"
    },
    "end": {
      "type": "string",
      "description": "Last month, YYYY-MM, or 'ongoing'.",
      "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?|ongoing)$"
    },
    "breaks": {
      "type": "array",
      "description": "Periods of leave inside start-end, YYYY-MM/YYYY-MM.",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])/\\d{4}-(0[1-9]|1[0-2])$"
      }
    },
    "employment_type": {
      "type": "string",
      "description": "permanent, contract, fixed-term, military-service, freelance, other.",
      "enum": [
        "",
        "permanent",
        "contract",
        "fixed-term",
        "military-service",
        "freelance",
        "other"
      ]
    },
    "tech": {
      "type": "array",
      "description": "Technologies used across the job that are not tied to one assignment.",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "description": "How sure the facts are: verified (the owner checked this entry), stated (the owner said it), old-cv, linkedin, needs-confirmation. Empty means not assessed.",
      "enum": [
        "",
        "verified",
        "stated",
        "old-cv",
        "linkedin",
        "needs-confirmation"
      ]
    },
    "status": {
      "type": "string",
      "description": "active, or removed (only in _removed/).",
      "enum": [
        "",
        "active",
        "removed"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "description": "Date the entry was last checked or changed (YYYY-MM-DD).",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$"
    },
    "removed": {
      "type": "string",
      "description": "Date the entry was removed.",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$",
      "x-scaffold": false
    },
    "removed_reason": {
      "type": "string",
      "description": "Why the entry was removed, in the owner's words.",
      "x-scaffold": false
    }
  },
  "required": [
    "schema",
    "id",
    "type",
    "employer",
    "title",
    "start"
  ],
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": {}
  },
  "additionalProperties": false,
  "x-sections": [
    "summary",
    "tech-in-practice",
    "own-words",
    "other",
    "flags"
  ]
}
