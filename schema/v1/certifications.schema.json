{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mortennordbye/openself/main/schema/v1/certifications.schema.json",
  "title": "Certifications",
  "description": "All certifications, one table row each: Name | Issuer | Date | Expires.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "description": "Schema version of this file.",
      "enum": [
        "1"
      ]
    },
    "id": {
      "type": "string",
      "description": "Stable id. Equal to the file name without .md. Never changed or reused.",
      "pattern": "^certifications$"
    },
    "type": {
      "type": "string",
      "description": "Entry type.",
      "enum": [
        "certifications"
      ]
    },
    "imports": {
      "type": "array",
      "description": "Public pages the table is imported from, so the import can run again: a Credly profile or a Microsoft Learn transcript link.",
      "items": {
        "type": "string"
      },
      "x-scaffold": false
    },
    "confidence": {
      "type": "string",
      "description": "How sure the facts are: verified (the owner checked this entry), stated (the owner said it), old-cv, linkedin, needs-confirmation. Empty means not assessed.",
      "enum": [
        "",
        "verified",
        "stated",
        "old-cv",
        "linkedin",
        "needs-confirmation"
      ]
    },
    "status": {
      "type": "string",
      "description": "active, or removed (only in _removed/).",
      "enum": [
        "",
        "active",
        "removed"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "description": "Date the entry was last checked or changed (YYYY-MM-DD).",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$"
    },
    "removed": {
      "type": "string",
      "description": "Date the entry was removed.",
      "pattern": "^(|\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))$",
      "x-scaffold": false
    },
    "removed_reason": {
      "type": "string",
      "description": "Why the entry was removed, in the owner's words.",
      "x-scaffold": false
    }
  },
  "required": [
    "schema",
    "id",
    "type"
  ],
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9-]*$": {}
  },
  "additionalProperties": false,
  "x-sections": [
    "other",
    "flags"
  ],
  "x-body": {
    "table": [
      "name",
      "issuer",
      "date",
      "expires"
    ]
  }
}
